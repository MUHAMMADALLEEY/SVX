# Create a Resend API key with sending permission. Never commit the real key.
RESEND_API_KEY=re_replace_with_your_key

# Must use an address at a domain verified in Resend.
RESEND_FROM_EMAIL=SVX Enquiries <enquiries@send.yourdomain.com>

# Inbox that receives every contact-form notification.
CONTACT_NOTIFICATION_EMAIL=you@yourdomain.com
